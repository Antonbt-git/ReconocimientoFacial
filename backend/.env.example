DATABASE_URL=postgresql://usuario:password@localhost:5432/reconocimiento_facial

# Paquete de modelos de InsightFace. "buffalo_sc" es liviano (~16MB) y
# recomendado para entornos con poca memoria como el plan gratuito de
# Render. "buffalo_l" es más preciso pero pesa ~281MB y requiere más
# memoria/CPU para cargarse.
INSIGHTFACE_MODEL_PACK=buffalo_sc

# Orígenes permitidos por CORS, separados por coma. Debe incluir la URL
# pública del frontend desplegado (sin barra final), por ejemplo:
# ALLOWED_ORIGINS=https://mi-frontend.vercel.app,http://localhost:5174
ALLOWED_ORIGINS=https://frontend-ssit.vercel.app
